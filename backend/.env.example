# ===== Servidor =====
# Puerto donde corre la API
PORT=4000

# Clave secreta para firmar las sesiones (tokens JWT).
# NO la escribas a mano: "npm run instalar" (o "npm run crear-env") genera una aleatoria de 64 caracteres.
# Nunca la compartas ni la subas a internet. Si se filtra, ejecuta: npm run crear-env -- --rotar
JWT_SECRET=cambia-esta-clave-por-una-frase-larga-y-secreta

# ===== PostgreSQL =====
# Escribe aquí la contraseña que pusiste al instalar PostgreSQL
DB_PASSWORD=escribe-aqui-tu-contraseña-de-postgres

# Normalmente no hace falta cambiar estos valores
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=ovilla

# ===== Solo para publicar en internet (Render, Railway, Neon…) =====
# Si tu proveedor te da una URL de conexión, pégala aquí y se ignorarán los DB_ de arriba
# DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/ovilla
# DB_SSL=true
# Si el sitio está detrás de un proxy (casi siempre en hosting), activa esto:
# TRUST_PROXY=1
